    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Launch Current File",
            "request": "launch",
            "mainClass": "${file}"
        },
        {
            "type": "java",
            "name": "Launch DataApeServer NG",
            "request": "launch",
            "mainClass": "com.isoplane.dataape.ng.DataApeServer",
            "projectName": "da-server-ng",
            "args": "${workspaceFolder}/.local/server.properties",
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "pwa-msedge",
            //    "type": "msedge",
            "request": "launch",
            "port": 9222,
            "name": "Launch Edge against localhost",
            "url": "http://localhost:4200",
            "webRoot": "${workspaceFolder}/da-frontend-ng"
        },
        // {
